{
  "name": "planomat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generator kalendarzy ICS (Planomat)",
  "scripts": {
    "start": "tsx src/cli.ts",
    "fetch": "tsx src/cli.ts --all --fetch --output-dir docs",
    "convert": "tsx src/cli.ts --calendar sp143 --input plan.xlsx --output-dir docs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@touch4it/ical-timezones": "^1.9.0",
    "exceljs": "^4.4.0",
    "ical-generator": "^9.0.0",
    "jszip": "^3.10.1",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
